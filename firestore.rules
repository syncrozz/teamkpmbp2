rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document for live status verification
    match /test/{docId} {
      allow read, write: if true;
    }

    // Portal Settings: Public read & real-time sync across all contingent devices
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    // Topics: Public read & real-time sync
    match /topics/{topicId} {
      allow read, write: if true;
    }
    
    // Subtopics: Public read & real-time sync
    match /subtopics/{subtopicId} {
      allow read, write: if true;
    }
    
    // Announcements: Public read & real-time sync
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    
    // Events: Public read & real-time sync
    match /events/{eventId} {
      allow read, write: if true;
    }
    
    // Schedules: Public read & real-time sync
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }
    
    // Infographics: Public read & real-time sync
    match /infographics/{infographicId} {
      allow read, write: if true;
    }
    
    // Documents: Public read & real-time sync
    match /documents/{docId} {
      allow read, write: if true;
    }
  }
}
